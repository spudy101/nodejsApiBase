{
  "name": "abundbank-microservices",
  "version": "1.0.0",
  "description": "Abundbank Microservices Architecture - Monorepo with pnpm workspaces",
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "comment1": "========== SETUP ==========",
    "install:all": "pnpm install",
    "clean": "pnpm run clean:modules && pnpm run clean:dist",
    "clean:modules": "rm -rf node_modules packages/*/node_modules",
    "clean:dist": "rm -rf packages/*/dist",
    
    "comment2": "========== DEVELOPMENT - TODOS LOS SERVICIOS ==========",
    "dev": "pnpm run dev:all",
    "dev:all": "concurrently -n \"KYC,NOTIF,ADMIN,CLIENT\" -c \"blue,green,yellow,magenta\" \"pnpm --filter @abundbank/kyc-service dev\" \"pnpm --filter @abundbank/notifications-service dev\" \"pnpm --filter @abundbank/admin-gateway dev\" \"pnpm --filter @abundbank/client-gateway dev\"",
    
    "comment3": "========== DEVELOPMENT - SERVICIOS INDIVIDUALES ==========",
    "dev:kyc": "pnpm --filter @abundbank/kyc-service dev",
    "dev:notifications": "pnpm --filter @abundbank/notifications-service dev",
    "dev:admin": "pnpm --filter @abundbank/admin-gateway dev",
    "dev:client": "pnpm --filter @abundbank/client-gateway dev",
    
    "comment4": "========== DEVELOPMENT - GRUPOS ==========",
    "dev:services": "concurrently -n \"KYC,NOTIF\" -c \"blue,green\" \"pnpm --filter @abundbank/kyc-service dev\" \"pnpm --filter @abundbank/notifications-service dev\"",
    "dev:gateways": "concurrently -n \"ADMIN,CLIENT\" -c \"yellow,magenta\" \"pnpm --filter @abundbank/admin-gateway dev\" \"pnpm --filter @abundbank/client-gateway dev\"",
    
    "comment5": "========== BUILD ==========",
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @abundbank/shared build",
    "build:kyc": "pnpm --filter @abundbank/kyc-service build",
    "build:notifications": "pnpm --filter @abundbank/notifications-service build",
    
    "comment6": "========== TESTING ==========",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm -r test:integration",
    "test:coverage": "pnpm -r test:coverage",
    "test:kyc": "pnpm --filter @abundbank/kyc-service test",
    "test:notifications": "pnpm --filter @abundbank/notifications-service test",
    
    "comment7": "========== LINTING ==========",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "prettier --write \"packages/**/*.{js,json,md}\"",
    "format:check": "prettier --check \"packages/**/*.{js,json,md}\"",
    
    "comment8": "========== DATABASE - MIGRACIONES ==========",
    "db:migrate": "pnpm run db:migrate:kyc && pnpm run db:migrate:notifications",
    "db:migrate:kyc": "pnpm --filter @abundbank/kyc-service db:migrate",
    "db:migrate:notifications": "pnpm --filter @abundbank/notifications-service db:migrate",
    "db:migrate:undo": "pnpm -r db:migrate:undo",
    "db:migrate:undo:all": "pnpm -r db:migrate:undo:all",
    
    "comment9": "========== DATABASE - SEEDS ==========",
    "db:seed": "pnpm run db:seed:kyc && pnpm run db:seed:notifications",
    "db:seed:kyc": "pnpm --filter @abundbank/kyc-service db:seed",
    "db:seed:notifications": "pnpm --filter @abundbank/notifications-service db:seed",
    "db:seed:undo": "pnpm run db:seed:undo:kyc && pnpm run db:seed:undo:notifications",
    "db:seed:undo:kyc": "pnpm --filter @abundbank/kyc-service db:seed:undo",
    "db:seed:undo:notifications": "pnpm --filter @abundbank/notifications-service db:seed:undo",
    
    "comment10": "========== DATABASE - RESET ==========",
    "db:reset": "pnpm run db:migrate:undo:all && pnpm run db:migrate && pnpm run db:seed",
    "db:reset:kyc": "pnpm --filter @abundbank/kyc-service db:reset",
    "db:reset:notifications": "pnpm --filter @abundbank/notifications-service db:reset",
    
    "comment11": "========== DOCKER ==========",
    "docker:build": "docker-compose -f infrastructure/docker/docker-compose.yml build",
    "docker:up": "docker-compose -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f infrastructure/docker/docker-compose.yml down",
    "docker:logs": "docker-compose -f infrastructure/docker/docker-compose.yml logs -f",
    "docker:clean": "docker-compose -f infrastructure/docker/docker-compose.yml down -v --remove-orphans",
    
    "comment12": "========== UTILIDADES ==========",
    "start": "pnpm run dev:all",
    "start:prod": "concurrently \"pnpm --filter @abundbank/kyc-service start\" \"pnpm --filter @abundbank/notifications-service start\" \"pnpm --filter @abundbank/admin-gateway start\" \"pnpm --filter @abundbank/client-gateway start\"",
    "logs": "pnpm run docker:logs"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.3",
    "prettier": "^3.2.4",
    "supertest": "^6.3.4"
  },
  "keywords": [
    "microservices",
    "monorepo",
    "pnpm",
    "nodejs",
    "express",
    "sequelize",
    "postgresql",
    "redis",
    "aws"
  ],
  "author": "Abundbank Team",
  "license": "MIT"
}