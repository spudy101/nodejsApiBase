# ==============================================
# CONFIGURACIÓN DE ENTORNO
# ==============================================
# Copia este archivo como .env y completa los valores

# ==============================================
# SERVER
# ==============================================
NODE_ENV=development
PORT=4000
HOST=localhost

# ==============================================
# CORS
# ==============================================
CORS_ORIGIN=*
# ⚠️ En producción: CORS_ORIGIN=https://tuapp.com,https://admin.tuapp.com

# ==============================================
# DATABASE - PostgreSQL [REQUERIDO]
# ==============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mi_database
DB_USER=mi_usuario
DB_PASSWORD=mi_password_seguro
DB_DIALECT=postgres
DB_SCHEMA=public
DB_LOGGING=false

# ==============================================
# REDIS CACHE [OPCIONAL]
# Si no se configura, usa caché en memoria local
# ==============================================
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_URL=                            # Alternativa para Railway/Heroku

# ==============================================
# ENCRYPTION [REQUERIDO]
# ==============================================
AES_KEY= ***                               # 32 bytes en hex (64 chars)
AES_IV= ***                                # 16 bytes en hex (32 chars)
ENCRYPTION_ALGORITHM= ***
EXTERNAL_API_KEYS= ***                     # API keys separadas por coma

# Generar claves:
# node ./shared/utils/generateKeys.util.js

# ==============================================
# RATE LIMITING CONFIGURATION
# ==============================================
RATE_LIMIT_WINDOW_MS= 900000        # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS= 100        # Max requests per window
RATE_LIMIT_AUTH_WINDOW_MS= 900000   # 15 minutes for auth endpoints
RATE_LIMIT_AUTH_MAX_REQUESTS= 10    # Max auth requests per window

# ==============================================
# AWS Credentials (admin operations)
# ==============================================
AWS_REGION= ***
AWS_ACCESS_KEY_ID= ***
AWS_SECRET_ACCESS_KEY= ***

# ==============================================
# COGNITO
# ==============================================
COGNITO_USER_POOL_ID= ***
COGNITO_CLIENT_ID= ***

# ==============================================
# ZAPSING
# ==============================================
ZAPSIGN_API_KEY = ***
ZAPSIGN_TEMPLATE_ID = ***
ZAPSIGN_BASE_URL = ***
ZAPSIGN_VALIDATION_TIMEOUT_MINUTES= 60

# ==============================================
# FRONTEND URLs [REQUERIDO]
# ==============================================
FRONTEND_RESET_URL= ***
ZAPSIGN_REDIRECT_URL_MOVIL = ***
ZAPSIGN_REDIRECT_URL_WEB = ***

# ==============================================
# NOTIFICATIONS [OPCIONAL]
# El sistema funciona sin estas, solo no notificará
# ==============================================
SNS_PLATFORM_ARN_IOS= ***
SNS_PLATFORM_ARN_ANDROID= ***
SES_FROM_EMAIL= ***
LOGO_URL= ***

# ==============================================
# LOGGING
# ==============================================
LOG_LEVEL= info                         # debug | info | warn | error

# ==============================================
# WORKER
# ==============================================
ENABLE_WORKERS= true