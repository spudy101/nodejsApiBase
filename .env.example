# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV=development

# ============================================
# SERVER PORTS
# ============================================
# KYC Service
KYC_PORT=4001
KYC_HOST=localhost

# Notifications Service
NOTIFICATIONS_PORT=4002
NOTIFICATIONS_HOST=localhost

# Admin Gateway
ADMIN_PORT=4100
ADMIN_HOST=localhost

# Client Gateway
CLIENT_PORT=4200
CLIENT_HOST=localhost

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=abundbank_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_DIALECT=postgres
DB_SCHEMA=public
DB_LOGGING=false

# ============================================
# REDIS
# ============================================
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# ENCRYPTION
# ============================================
AES_KEY=your_32_char_aes_key_here______
AES_IV=your_16_char_iv__
ENCRYPTION_ALGORITHM=aes-256-cbc
EXTERNAL_API_KEYS=key1,key2,key3

# ============================================
# SECURITY - Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX_REQUESTS=10

# ============================================
# AWS CREDENTIALS
# ============================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# ============================================
# AWS S3
# ============================================
BUCKET_NAME=abundbank-uploads

# ============================================
# AWS COGNITO
# ============================================
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# AWS SES (Email)
# ============================================
SES_FROM_EMAIL=noreply@abundbank.com
LOGO_URL=https://abundbank.com/logo.png

# ============================================
# AWS SNS (Push Notifications)
# ============================================
SNS_PLATFORM_ARN_IOS=arn:aws:sns:us-east-1:xxx:app/APNS/abundbank-ios
SNS_PLATFORM_ARN_ANDROID=arn:aws:sns:us-east-1:xxx:app/GCM/abundbank-android

# ============================================
# ZAPSIGN
# ============================================
ZAPSIGN_API_KEY=your_zapsign_api_key
ZAPSIGN_TEMPLATE_ID=your_template_id
ZAPSIGN_BASE_URL=https://api.zapsign.com.br
ZAPSIGN_REDIRECT_URL_MOVIL=abundbank://zapsign/callback
ZAPSIGN_REDIRECT_URL_WEB=https://abundbank.com/zapsign/callback
ZAPSIGN_VALIDATION_TIMEOUT_MINUTES=60

# ============================================
# FRONTEND URLs
# ============================================
FRONTEND_RESET_URL=https://abundbank.com/reset-password

# ============================================
# CORS
# ============================================
CORS_ORIGIN=*

# ============================================
# WORKERS
# ============================================
ENABLE_WORKERS=true

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
