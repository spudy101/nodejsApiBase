# SERVER
NODE_ENV=development
PORT=4002
HOST=localhost
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# DATABASE - Notifications Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=abundbank_notifications
DB_USER=postgres
DB_PASSWORD=postgres
DB_DIALECT=postgres
DB_SCHEMA=public
DB_LOGGING=false

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ENCRYPTION
AES_KEY=your-32-character-secret-key-here123
AES_IV=your-16-char-iv
ENCRYPTION_ALGORITHM=aes-256-cbc

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# SES (Email)
SES_FROM_EMAIL=noreply@abundbank.com
LOGO_URL=https://abundbank.com/logo.png

# SNS (Push Notifications)
SNS_PLATFORM_ARN_IOS=arn:aws:sns:us-east-1:xxxxx:app/APNS/AbundBankIOS
SNS_PLATFORM_ARN_ANDROID=arn:aws:sns:us-east-1:xxxxx:app/GCM/AbundBankAndroid

# RATE LIMITING
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# LOGGING
LOG_LEVEL=info

# WORKERS
ENABLE_WORKERS=true
