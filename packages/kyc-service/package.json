{
  "name": "@abundbank/kyc-service",
  "version": "1.0.0",
  "description": "KYC Microservice - User authentication, profile, and identity validation",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "comment1": "========== DEVELOPMENT ==========",
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "build": "echo 'No build step required'",
    
    "comment2": "========== TESTING ==========",
    "test": "cross-env NODE_ENV=test jest",
    "test:unit": "cross-env NODE_ENV=test jest --testMatch='**/tests/unit/**/*.test.js'",
    "test:integration": "cross-env NODE_ENV=test jest --testMatch='**/tests/integration/**/*.test.js'",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage",
    
    "comment3": "========== LINTING ==========",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix",
    
    "comment4": "========== DATABASE ==========",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate",
    
    "comment5": "========== DOCKER ==========",
    "docker:build": "docker build -f Dockerfile -t kyc-service:latest .",
    "docker:run": "docker run -p 4001:4001 --env-file .env kyc-service:latest"
  },
  "dependencies": {
    "@abundbank/shared": "workspace:*",
    "@aws-sdk/client-cognito-identity-provider": "^3.966.0",
    "@aws-sdk/client-s3": "^3.972.0",
    "axios": "^1.13.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "sharp": "^0.34.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.0.3",
    "sequelize-cli": "^6.6.3",
    "sqlite3": "^5.1.7",
    "supertest": "^6.3.4"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      "server.js"
    ],
    "ext": "js,json",
    "ignore": [
      "node_modules",
      "tests",
      "*.test.js"
    ],
    "delay": "1000"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js",
      "!src/config/**",
      "!src/infrastructure/database/models/**",
      "!src/swagger/**"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}