# SERVER
NODE_ENV=development
PORT=4001
HOST=localhost
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# DATABASE - KYC Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=abundbank_kyc
DB_USER=postgres
DB_PASSWORD=postgres
DB_DIALECT=postgres
DB_SCHEMA=public
DB_LOGGING=false

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ENCRYPTION
AES_KEY=your-32-character-secret-key-here123
AES_IV=your-16-char-iv
ENCRYPTION_ALGORITHM=aes-256-cbc

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
BUCKET_NAME=abundbank-kyc-documents

# COGNITO
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=your_client_id

# ZAPSIGN
ZAPSIGN_API_KEY=your_api_key
ZAPSIGN_TEMPLATE_ID=your_template_id
ZAPSIGN_BASE_URL=https://api.zapsign.com.br
ZAPSIGN_REDIRECT_URL_MOVIL=abundbank://identity-validation
ZAPSIGN_REDIRECT_URL_WEB=https://app.abundbank.com/identity-validation
ZAPSIGN_VALIDATION_TIMEOUT_MINUTES=60

# FRONTEND
FRONTEND_RESET_URL=http://localhost:3000/reset-password

# RATE LIMITING
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX_REQUESTS=10

# LOGGING
LOG_LEVEL=info

# WORKERS
ENABLE_WORKERS=true